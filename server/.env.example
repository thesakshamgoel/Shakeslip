# Copy to .env. Never commit .env.
PORT=8787
APP_URL=http://localhost:5173
NODE_ENV=development
DB_PATH=./data/shakeslip.db
# Optional: Firebase project id, turns on Continue with Google (Firebase console > Project settings).
FIREBASE_PROJECT_ID=
# Optional: real email sending through Resend. Without a key, emails are saved to the in-app mailbox only.
RESEND_API_KEY=
MAIL_FROM=Shakeslip <no-reply@example.com>
